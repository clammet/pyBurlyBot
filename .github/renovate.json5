{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "customManagers:githubActionsVersions"
  ],
  "timezone": "Australia/Melbourne",
  "labels": [
    "dependencies"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "3 days",
  "pip_requirements": {
    "enabled": false
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements(-dev)?\\.txt$/"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "rebaseWhen": "behind-base-branch"
  },
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "automerge": true
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Automerge non-major updates once required checks pass; rebase onto main first so the checks ran against the current base",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "description": "Attempt major updates automatically after a week; CI must pass before merge",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "dependencyDashboardApproval": false
    },
    {
      "description": "Pre-1.0 updates use the same required CI gate",
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "Never automerge GitHub Actions digest changes",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "automerge": false
    },
    {
      "description": "A Python minor is a runtime upgrade (bump ruff target-version, CI python-version alongside): human decision",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": false
    },
    {
      "description": "Own image in docker-compose.yml is built locally and rolled by deploy, not pinned here",
      "matchDepNames": [
        "ghcr.io/clammet/pyburlybot"
      ],
      "enabled": false
    },
    {
      "description": "Renovate engine: several releases a day, so take the weekly one; no digest pin because the annotated RENOVATE_VERSION env var holds a plain tag",
      "matchDepNames": [
        "ghcr.io/renovatebot/renovate"
      ],
      "schedule": [
        "before 6am on monday"
      ],
      "pinDigests": false
    },
    {
      "description": "Keep Node image, CI runtime, and Node types in one tested PR",
      "matchPackageNames": [
        "node",
        "@types/node"
      ],
      "groupName": "Node runtime"
    }
  ],
  "platformAutomerge": false,
  "rebaseWhen": "behind-base-branch",
  "description": "Renovate owns dependency updates. Tested updates merge after the release soak; unresolved maintenance is reported by the maintenance workflows. See .github/MAINTENANCE.md.",
  "automergeType": "pr"
}
