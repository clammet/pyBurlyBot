{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>yuzuyuzuyu/repo-automation:public#v1.0.24"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 10,
  "pip_requirements": {
    "enabled": false
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements(-dev)?\\.txt$/"
    ]
  },
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "The Docker Python image drives CI, Ruff, and lockfile compilation settings",
      "matchPackageNames": [
        "python",
        "actions/python-versions"
      ],
      "groupName": "Python runtime"
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:non-major#v1.0.24"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:major#v1.0.24"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:pre-one#v1.0.24"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:action-digest-review#v1.0.24"
      ]
    },
    {
      "description": "CI Python follows the Docker image through the runtime synchronization task",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "Synchronize Python settings and regenerate lockfiles during Docker runtime updates",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python"
      ],
      "postUpgradeTasks": {
        "commands": [
          "python3 -m venv .venv",
          ".venv/bin/python -m pip install --require-hashes -r requirements-dev.txt",
          ".venv/bin/python python_runtime.py --write"
        ],
        "installTools": {
          "python": true
        },
        "fileFilters": [
          ".github/workflows/ci.yml",
          "pyproject.toml",
          "requirements*.in",
          "requirements*.txt",
          "docs/dependencies.md",
          "**/*.py"
        ],
        "executionMode": "branch"
      }
    },
    {
      "description": "Python major upgrades still require a human decision",
      "matchDepNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Own image in docker-compose.yml is built locally and rolled by deploy, not pinned here",
      "matchDepNames": [
        "ghcr.io/clammet/pyburlybot"
      ],
      "enabled": false
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:renovate-engine#v1.0.24"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:node-runtime#v1.0.24"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:automation-updates#v1.0.24"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:age-3-days#v1.0.24"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:age-7-days#v1.0.24"
      ]
    }
  ]
}
