{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // best-practices pins action + docker digests and enables config migration
  // and the dependency dashboard (via config:recommended).
  extends: ['config:best-practices', 'customManagers:githubActionsVersions'],
  timezone: 'Australia/Sydney',
  labels: ['dependencies'],
  // Self-hosted hourly runner; Renovate's own rate limits just add latency.
  prHourlyLimit: 0,
  prConcurrentLimit: 10,
  // Fleet-standard soak: let a release age before adopting it. Vulnerability
  // fix PRs (Dependabot alerts / OSV) skip it.
  minimumReleaseAge: '3 days',
  // requirements*.in/.txt belong to the pip-compile manager (it reads the
  // compile command from each lockfile's header); stop the plain
  // requirements-file manager from double-managing them.
  pip_requirements: { enabled: false },
  'pip-compile': {
    managerFilePatterns: ['/^requirements(-dev)?\\.txt$/'],
  },
  // Weekly full lockfile recompile picks up transitive releases that no
  // direct-pin bump would surface.
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
  },
  // The app token has Dependabot alerts: read, so alerts become PRs here
  // (Dependabot's own PRs are disabled — see .github/dependabot.yml).
  vulnerabilityAlerts: {
    labels: ['security'],
  },
  osvVulnerabilityAlerts: true,
  packageRules: [
    {
      description: 'Automerge non-major updates once required checks pass',
      matchUpdateTypes: ['minor', 'patch', 'pin', 'pinDigest', 'digest'],
      automerge: true,
    },
    {
      description: 'Majors wait for a human',
      matchUpdateTypes: ['major'],
      automerge: false,
    },
    {
      description: '0.x minors are breaking by semver convention - hold them for a human',
      matchCurrentVersion: '<1.0.0',
      matchUpdateTypes: ['minor'],
      automerge: false,
    },
    {
      description: 'Pins and digest refreshes point at code that already shipped - no soak needed',
      matchUpdateTypes: ['pin', 'pinDigest', 'digest'],
      minimumReleaseAge: null,
    },
    {
      description: 'A Python minor is a runtime upgrade (bump ruff target-version, CI python-version alongside): human decision',
      matchDatasources: ['docker'],
      matchDepNames: ['python'],
      matchUpdateTypes: ['minor'],
      automerge: false,
    },
    {
      description: 'Own image in docker-compose.yml is built locally and rolled by deploy, not pinned here',
      matchDepNames: ['ghcr.io/clammet/pyburlybot'],
      enabled: false,
    },
    {
      description: 'Renovate engine: several releases a day, so take the weekly one; no digest pin because the annotated RENOVATE_VERSION env var holds a plain tag',
      matchDepNames: ['ghcr.io/renovatebot/renovate'],
      schedule: ['before 6am on monday'],
      pinDigests: false,
    },
  ],
}
