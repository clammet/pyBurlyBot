# Dev/CI tooling, pinned exactly. Compiled against requirements.txt as a
# constraint so shared transitives resolve to the same versions. To recompile:
#
#   .venv/bin/uv pip compile --universal --generate-hashes --python-version=3.15 --constraint=requirements.txt --output-file=requirements-dev.txt requirements-dev.in
#
# The equals-form flags matter: Renovate parses the command header in
# requirements-dev.txt and rejects space-separated option arguments.
mypy==2.4.1
ruff==0.17.3
uv==0.13.6
